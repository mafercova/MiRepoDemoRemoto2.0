<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnFragmentoUno"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/boton_uno"
        app:layout_constraintEnd_toStartOf="@id/btnFragmentoDos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo" />

    <Button
        android:id="@+id/btnFragmentoDos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/boton_dos"
        app:layout_constraintEnd_toStartOf="@id/btnFragmentoTres"
        app:layout_constraintStart_toEndOf="@id/btnFragmentoUno"
        app:layout_constraintTop_toBottomOf="@id/titulo" />

    <Button
        android:id="@+id/btnFragmentoTres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/boton_tres"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnFragmentoDos"
        app:layout_constraintTop_toBottomOf="@id/titulo" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorFragmento"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnFragmentoUno" />

</androidx.constraintlayout.widget.ConstraintLayout>